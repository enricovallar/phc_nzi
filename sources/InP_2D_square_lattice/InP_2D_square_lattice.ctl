(set! num-bands 8)
(set! resolution 32)
(set! k-points (list (vector3 0.2 0.0 0.0) (vector3 0.0 0.0 0.0) (vector3 0.0 0.2 0.0)))
(set! k-points (interpolate 10 k-points))
(define-param radius 0.2)
(define-param r 0.2)
(define-param r2 0.15)
(set! geometry-lattice (make lattice (size 1 1 no-size)  (basis1  (vector3 1.0 0.0 0.0)) (basis2  (vector3 0.0 1.0 0.0)) ))
(set! geometry (list 
 (make block (center (vector3 0.0 0.0 0.0))
  (size (vector3 1e+20 1e+20 1e+20))
  (material (make dielectric (epsilon 9.61))))
 (make cylinder (center (vector3 0.0 0.0 0.0))
  (radius r)
  (height 1e+20)
  (material (make dielectric (epsilon 1))))
))
(run-te)
(run-tm)
